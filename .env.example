# BigCommerce API account (Settings > API > Store-level API accounts)
# Needs scopes: Products (read-only is enough), Orders (read-only),
# Customers (MODIFY — required to read/write customer metafields)
BC_STORE_HASH=xxxxxxx
BC_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BC_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The client secret for the SAME API account above. This is what verifies the
# customer.jwt BigCommerce issues to the logged-in storefront shopper.
BC_JWT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your live storefront origin, e.g. https://www.yourstore.com
# (used for the CORS header on /api/check-limit)
ALLOWED_ORIGIN=https://www.yourstore.com

# Any long random string you invent yourself. Put the SAME value in the
# webhook URL you register with BigCommerce, as ?secret=...
WEBHOOK_SHARED_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
